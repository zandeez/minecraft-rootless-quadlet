[Unit]
Description=Minecraft Server (%NAME%)

[Container]
Image=localhost/minecraft_server:latest
PublishPort=%GAME_PORT%:25565/tcp
PublishPort=%RCON_PORT%:25575/tcp
Volume=%PATH%/instances/%NAME%/data:/data:rw,Z,U
AutoUpdate=local
UserNS=keep-id

[Service]
Restart=always

[Install]
WantedBy=default.target
